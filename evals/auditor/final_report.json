    "clean": {
      "schema": "final_report.v1",
      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "An edge was found.",
      "outcome": "inconclusive",
      "claims": [
        {
          "text": "Sharpe of 1.8 after costs.",
          "class": "result",
          "value": 1.8,
