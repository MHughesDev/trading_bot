[
  {
    "id": "uncited_number_in_a_claim",
    "check": "final_report",
    "why": "A number in prose with nothing to resolve it against is how an unchecked figure enters a report. Nobody lies here; a figure gets recomputed during the write-up, drifts, and is never reconciled with the run that produced it.",
    "violating": {
      "schema": "final_report.v1",
      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "No edge was found.",
      "outcome": "inconclusive",
      "claims": [
        {
          "text": "The strategy returned 3.2% out of sample.",
          "class": "result",
          "evidence": ["exp_abc"]
        }
      ]
    },
    "clean": {
      "schema": "final_report.v1",
      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "No edge was found.",
      "outcome": "inconclusive",
      "claims": [
        {
          "text": "The strategy returned 3.2% out of sample.",
          "class": "result",
          "value": 0.032,
          "unit": "return",
          "evidence": ["exp_abc"]
        }
      ]
    },
    "expect": ["uncited_number_in_text"]
  },
  {
