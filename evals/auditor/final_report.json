      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "One candidate survived.",
      "outcome": "answered",
      "exploration_ledger_ref": "art_led_1",
      "candidates": [
        {
          "strategy_ref": "str_1",
          "experiment_id": "exp_1",
