  {
    "id": "an_answer_with_no_exploration_ledger",
    "check": "final_report",
    "why": "The ledger is the report's denominator (D-13). An answered report without it hides how much searching preceded the verdict, which is the difference between a finding and the best of two hundred guesses.",
    "violating": {
      "schema": "final_report.v1",
      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "No exploitable structure was found.",
      "outcome": "answered"
    },
    "clean": {
      "schema": "final_report.v1",
      "session_id": "ses_1",
      "project_id": "prj_1",
      "answer": "No exploitable structure was found.",
      "outcome": "answered",
      "exploration_ledger_ref": "art_led_1"
    },
    "expect": ["missing_exploration_ledger"]
  },
  {
    "id": "the_honest_null_report_is_filable",
    "check": "final_report",
    "why": "The most important clean twin in the suite. The correct answer to a pure-noise task is a report claiming nothing, and if that report is harder to file than a discovery the validator has inverted the incentive it exists to protect. The violating side here is the same report with a number nobody can check.",
    "violating": {
      "schema": "final_report.v1",
      "session_id": "ses_noise",
      "project_id": "prj_noise",
      "answer": "No edge. Best candidate reached a Sharpe of 0.9 but did not pass Gate 1.",
      "outcome": "answered",
      "exploration_ledger_ref": "art_led_noise",
      "caveats": ["The instrument may contain structure this search did not reach."]
    },
    "clean": {
      "schema": "final_report.v1",
      "session_id": "ses_noise",
      "project_id": "prj_noise",
      "answer": "No edge was found. Every candidate failed at Gate 1 under the pessimistic cost model.",
      "outcome": "answered",
      "exploration_ledger_ref": "art_led_noise",
      "caveats": [
        "The instrument may contain structure this search did not reach.",
        "Absence of evidence over this window is not evidence of absence over any other."
      ]
    },
    "expect": ["uncited_number_in_answer"]
  }
]
